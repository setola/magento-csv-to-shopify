NODE_IMAGE=node:alpine

# Shopify Store Configuration
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_LOCATION_ID=gid://shopify/Location/xxxxxxxxxxxxx
# Paganini imports/syncs use this separate Shopify location instead of SHOPIFY_LOCATION_ID.
# If PAGANINI_LOCATION_ID is empty, scripts resolve the active location by name.
PAGANINI_LOCATION_NAME=Paganini
PAGANINI_LOCATION_ID=

# Magento Configuration
MAGENTO_BASE_URL=https://www.your-magento-store.com
MAGENTO_MEDIA_PATH=/pub/media/catalog/product

# CSV Configuration
CSV_PATH=./products.csv
PAGANINI_CSV_PATH=./data/paganini_data_*.csv
# Paganini filters: optics (default, Leupold optics only), leupold/all (all Leupold rows)
PAGANINI_PRODUCT_FILTER=optics

# Batch Configuration
START_ROW=0
BATCH_SIZE=100

# Rate Limiting Configuration
MAX_CONCURRENT=2
DELAY_MS=500

# Logging
LOG_FILE=./logs/migration.log

# Content enrichment generation with AI
# Generates a local per-product content.md folder. It does not write to Shopify.
# Supported providers: gemini, openai
AI_PROVIDER=gemini
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-4.1-mini
CONTENT_OUTPUT_DIR=./data/content-enrichment
# Optional: force a specific product handle instead of auto-selecting the first empty product.
PRODUCT_HANDLE=
PRODUCT_QUERY=status:active
MAX_PAGES=20
PAGE_SIZE=50
MIN_DESCRIPTION_CHARS=180
DOWNLOAD_IMAGES=true
MAX_IMAGES=6

# Content enrichment upload
# Reads a per-product content.md folder generated under data/content-enrichment/.
PRODUCT_DIR=./data/content-enrichment/leupold-vx-4hd-3-12x40-cds-zl2-firedot-twilight-hunter
# Safe by default: Shopify is updated only when CONFIRM_WRITE=true.
CONFIRM_WRITE=false
UPDATE_CONTENT=true
UPLOAD_IMAGES=true
# Skip tiny images, reject images over Shopify's 20 MP limit, and dedupe resized variants.
MIN_IMAGE_WIDTH=500
MIN_IMAGE_HEIGHT=500
MIN_IMAGE_PIXELS=500000
MAX_IMAGE_PIXELS=20000000

# Web Downloader Configuration
# Copy this file to .env and update with your actual values

# Login URL - The URL where you need to authenticate
LOGIN_URL=https://example.com/login

# Download URL - The URL to download the CSV file from (after authentication)
DOWNLOAD_URL=https://example.com/export/csv

# Authentication credentials
WEB_USERNAME=your_username
WEB_PASSWORD=your_password

# Output configuration
OUTPUT_DIR=./data
DOWNLOAD_FILENAME=exported_data.csv

# Form fields for login (customize based on your login form)
# These define the field names used in the login form
LOGIN_FORM_FIELD1=username
LOGIN_FORM_FIELD2=password